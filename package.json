{
  "name": "dango",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Chat with every agent on your computer, in groups, and hand them coding work. One local web page.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node --watch server/index.ts --dev",
    "dev:web": "vite",
    "build": "vite build",
    "setup": "node scripts/setup.ts",
    "launch": "node scripts/launch.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.107.0",
    "@agentclientprotocol/codex-acp": "2.6.0",
    "@agentclientprotocol/sdk": "^2.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
